# Copia este archivo a .env y pon tus valores reales.
# .env está en .gitignore: nunca se sube a GitHub.

# --- PostgreSQL (contenedor dz-postgres) ---
POSTGRES_USER=dz
POSTGRES_PASSWORD=pon-aqui-una-password-larga
POSTGRES_DB=dz_inventory
POSTGRES_PORT=5432

# --- Redis (contenedor dz-redis) ---
REDIS_PORT=6379

# --- API Go (corre en tu PC, no en contenedor) ---
API_PORT=8080

# --- Supabase Storage (opcional en desarrollo; nunca pongas aquí una clave real) ---
# DZ_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# DZ_SUPABASE_SERVICE_ROLE_KEY=pon-aqui-la-clave-solo-en-el-servidor
# DZ_SUPABASE_FOTOS_BUCKET=fotos
